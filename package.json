{
  "name": "sunrise-montessori-erp",
  "version": "1.0.0",
  "description": "School management software for Sunrise Montessori School — students, attendance, examinations, certificates, fees, payroll and reports. All data is stored on this computer.",
  "main": "out/main/index.js",
  "author": "OneT Digital Solutions",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.js",
    "build:web": "vite build --config vite.web.config.js",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "in.onetdigital.sunrise.erp",
    "productName": "Sunrise Montessori ERP",
    "copyright": "Copyright © 2026 OneT Digital Solutions",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!**/node_modules/puppeteer*/**",
      "!**/node_modules/whatsapp-web.js/**",
      "!**/node_modules/**/*.{md,markdown,map,ts,flow}",
      "!**/node_modules/**/{test,__tests__,docs,example,examples}/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Sunrise-Montessori-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sunrise Montessori ERP",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "whatsapp-web.js": "^1.26.0"
  }
}
